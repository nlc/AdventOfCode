def add_tallies(t1, t2)
  (t1.keys | t2.keys).map do |k|
    v1 = t1[k] || 0
    v2 = t2[k] || 0

    [k, v1 + v2]
  end.to_h
end

def subtract_tallies(t1, t2)
  (t1.keys | t2.keys).map do |k|
    v1 = t1[k] || 0
    v2 = t2[k] || 0

    [k, v1 - v2]
  end.to_h
end


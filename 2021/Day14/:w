def iterate(template, rules)
  template.each_cons(2).map do |a|
    [a[0], rules[a.join]]
  end.flatten + [template.last]
end

def iterate_old(template, rules)
  template.each_cons(2).map do |a|
    [a[0], rules[a.join], a[1]].compact[..1]
  end.flatten.join + [template.last]
end

